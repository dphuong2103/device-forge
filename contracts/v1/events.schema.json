{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-force.local/contracts/v1/events.schema.json",
  "title": "Agent event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "occurredAt", "correlationId", "payload"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "enum": [
        "agent.status",
        "device.changed",
        "command.progress",
        "command.completed",
        "stream.changed",
        "entitlement.changed",
        "diagnostic"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0 },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" }
  }
}
